models/
checkpoints/
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.pb
.cache/
huggingface/

# ====================
# OPERATING SYSTEM
# ====================
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*

# ====================
# IDE & EDITORS
# ====================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
