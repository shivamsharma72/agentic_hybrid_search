DATA/tables_parquet_final/*.parquet
sol_export/*.parquet
data/raw/*.jsonl
data/raw/*.jsonl.gz
data/processed/reviews_Electronics/*.parquet
data/processed/reviews_Electronics/*.jsonl
data/processed/parquet/*.parquet

# Phase-specific large data
03_analysis/laptop_titles_analysis.csv
03_analysis/laptop_titles_analysis_asins_only.csv
03_analysis/laptops_category_details.csv
03_analysis/laptops_category_details_asins_only.csv
03_analysis/laptops_parent_category_products.csv

# ====================
# PYTHON
# ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Jupyter
.ipynb_checkpoints
*.ipynb

# ====================
# NODE / FRONTEND
# ====================
node_modules/
.next/
out/
build/
dist/
.vercel
.netlify
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
coverage/
.nyc_output/
*.tsbuildinfo
next-env.d.ts

# ====================
# ENVIRONMENT & SECRETS
# ====================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!env.example
!**/.env.example
*_key.txt
*.key
*.pem
secrets/
secrets.json
credentials.json

# ====================
# DATABASE
# ====================
*.db
*.sqlite
*.sqlite3
postgres_data/
pgdata/
*.sql.gz
*.dump
*.backup

